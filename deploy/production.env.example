# Template for the server's .env next to docker-compose.prod.yml: only what compose itself needs.
# The application's own configuration lives in config/app.env (template: deploy/app.env.example).
# The filled-in file never belongs in git.

# Public hostname without scheme, e.g. indicate-data.com. DNS must point at the server.
SITE_DOMAIN=
# Address Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=

# Database password for the PostgreSQL that ships with this stack. Set it BEFORE the
# first start; changing it later needs an ALTER USER as well.
# Generate with: openssl rand -hex 32   (hex keeps it safe inside the database URL)
POSTGRES_PASSWORD=

# Leave unset to use the PostgreSQL in this stack. Set it to point the app at an
# external cluster instead - with client-certificate authentication, this is the whole
# configuration. See deploy/README.md, "An external PostgreSQL with mTLS".
# DATABASE_URL=postgres://indicate_website@10.80.30.8:6432/indicate_website?sslmode=verify-full&sslrootcert=/app/tls/postgres/server-ca.pem&sslcert=/app/tls/postgres/client.cert.pem&sslkey=/app/tls/postgres/client.key.pem
