# Template for the server's .env next to docker-compose.prod.yml: only what compose itself needs.
# The application's own configuration lives in config/app.env (template: deploy/app.env.example).
# The filled-in file never belongs in git.

# Public hostname without scheme, e.g. indicate-data.com. DNS must point at the server.
SITE_DOMAIN=
# Address Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=

# Database password. Set it BEFORE the first start; changing it later needs an ALTER USER.
# Generate with: openssl rand -hex 32   (hex keeps it safe inside the database URL)
POSTGRES_PASSWORD=
