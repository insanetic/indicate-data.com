# Template for the application's configuration, mounted into the container as /app/config/app.env
# (see docker-compose.prod.yml). Every line overrides the same key in the image's defaults.env;
# a variable set on the container itself wins over this file. Plain KEY=VALUE, no shell syntax.
# The filled-in file never belongs in git.
#
# Generate each secret with: openssl rand -hex 32

# Public origin of the site, e.g. https://indicate-data.com (must match SITE_DOMAIN in .env).
SITE_URL=

# Google Tag Manager container id (GTM-XXXXXXX). Empty: no tracker and no consent banner.
GTM_ID=

# Payload: signs sessions and encrypts stored keys (the MCP access key, API keys).
# Never change it on a database that has content, or those values become unreadable.
PAYLOAD_SECRET=
# Live preview links from the admin panel.
PREVIEW_SECRET=
# Bearer token for Payload's scheduled jobs endpoint.
CRON_SECRET=

# Optional: Subneo pricing API key (can also be stored in the admin under Subneo pricing).
SUBNEO_API_KEY=

# Only when the database is not the compose-managed one (otherwise compose sets it):
# DATABASE_URL=postgres://payload:<password>@postgres:5432/payload
