# Caddy obtains and renews the Let's Encrypt certificate for SITE_DOMAIN on its own.
# Requirements: the domain's DNS points at this server and ports 80 and 443 are open.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Payload uploads: allow large media files through.
	request_body {
		max_size 100MB
	}

	reverse_proxy app:3000
}

# www -> apex. Remove this block if www has no DNS record, otherwise Caddy keeps
# retrying a certificate for it.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
