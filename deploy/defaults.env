# Defaults baked into the image (/app/defaults.env). Every value can be overridden by a file
# mounted into /app/config/ or by the container environment; see deploy/docker-entrypoint.sh.

# Public origin of the site. Used for canonical links, sitemaps, Open Graph and CORS.
SITE_URL=http://localhost:3000

# Google Tag Manager container id. Fallback for the admin field (Cookies & tracking →
# Integrations), which wins when it is filled. Neither: no tracker and no consent banner.
GTM_ID=

# Uploads directory (a volume) and running pending migrations on start.
MEDIA_DIR=/app/media
PAYLOAD_MIGRATE_ON_START=true
